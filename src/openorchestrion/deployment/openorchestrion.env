# OpenOrchestrion reference appliance configuration.
# systemd reads this file directly; use KEY=value syntax without shell expansion.
# The kiosk and smoke commands also read it, so the reference installer makes
# it world-readable. Keep provider API keys/passwords/secrets somewhere else.

OPENORCHESTRION_LIBRARY_ROOT=/var/lib/openorchestrion/library
OPENORCHESTRION_CATALOG_DB=/var/lib/openorchestrion/library/catalog.db
OPENORCHESTRION_HISTORY_DB=/var/lib/openorchestrion/history.db

# Production should use physical MIDI when present. Set to 1 only for
# hardware-free development and diagnostics.
OPENORCHESTRION_VIRTUAL_MIDI=0

# Bind to the LAN while keeping the kiosk itself on localhost.
OPENORCHESTRION_HOST=0.0.0.0
OPENORCHESTRION_PORT=8000
OPENORCHESTRION_LOG_LEVEL=info

# The installation under /opt is read-only to the service.
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
