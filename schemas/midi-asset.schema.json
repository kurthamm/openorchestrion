{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openorchestrion.example/schemas/midi-asset.schema.json",
  "title": "OpenOrchestrion MIDI Asset Sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "asset_id", "file", "provenance", "deterministic_analysis", "descriptive_metadata", "ai_enrichment"],
  "properties": {
    "schema_version": {"const": 1},
    "asset_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_filename", "stored_filename", "sha256", "size_bytes"],
      "properties": {
        "original_filename": {"type": "string", "minLength": 1},
        "stored_filename": {"type": "string", "pattern": "^[0-9a-f]{64}\\.mid$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imported_at", "rights_status", "source_reference", "source_label", "license", "attribution"],
      "properties": {
        "imported_at": {"type": "string", "format": "date-time"},
        "rights_status": {"type": "string", "enum": ["personal", "verified-open", "unknown"]},
        "source_reference": {"type": ["string", "null"]},
        "source_label": {"type": ["string", "null"]},
        "license": {"type": ["string", "null"]},
        "license_url": {"type": ["string", "null"]},
        "attribution": {"type": ["string", "null"]},
        "composition_rights": {"type": "string", "enum": ["public-domain", "licensed", "in-copyright", "unknown"]},
        "composition_rights_basis": {"type": ["string", "null"]},
        "redistribution": {"type": "string", "enum": ["permitted", "permitted-with-attribution", "prohibited", "unknown"]},
        "verified_at": {"type": ["string", "null"]},
        "verified_by": {"type": ["string", "null"]}
      }
    },
    "deterministic_analysis": {"$ref": "midi-analysis.schema.json"},
    "descriptive_metadata": {
      "type": "object",
      "description": "Curated or user-edited descriptive fields. Kept separate from facts extracted from MIDI bytes.",
      "additionalProperties": false,
      "properties": {
        "composition_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "composition_title": {"type": "string", "minLength": 1},
        "composer": {"type": "string", "minLength": 1},
        "artist": {"type": "string", "minLength": 1},
        "year_composed": {"type": "integer", "minimum": 1, "maximum": 9999},
        "era": {"type": "string", "minLength": 1},
        "genres": {"$ref": "#/$defs/stringList"},
        "moods": {"$ref": "#/$defs/stringList"},
        "themes": {"$ref": "#/$defs/stringList"},
        "tags": {"$ref": "#/$defs/stringList"},
        "instrumentation": {"$ref": "#/$defs/stringList"},
        "performance_type": {
          "type": "string",
          "enum": ["SOLO_PIANO", "MULTI_INSTRUMENT", "PIANO_DUET", "TWO_PIANO", "DUELING_PIANO", "DISTRIBUTED"]
        },
        "quality_grade": {"type": "string", "enum": ["A", "B", "C", "D"]},
        "familiarity": {"$ref": "#/$defs/level"},
        "energy": {"$ref": "#/$defs/level"},
        "favorite": {"type": "boolean"}
      }
    },
    "ai_enrichment": {
      "type": "array",
      "description": "Future AI-inferred metadata entries with explicit model/provenance information.",
      "items": {"type": "object"}
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "level": {
      "oneOf": [
        {"type": "string", "enum": ["low", "medium", "high"]},
        {"type": "integer", "minimum": 1, "maximum": 5}
      ]
    }
  }
}
